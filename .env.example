# Zettelkasten MCP Server Configuration

# Storage paths
ZETTELKASTEN_NOTES_DIR=./data/notes
ZETTELKASTEN_DATABASE_PATH=./data/db/zettelkasten.db

# Logging
ZETTELKASTEN_LOG_LEVEL=INFO

# HTTP Server Configuration (for remote access via Cloudflare Tunnel)
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# CORS Configuration (comma-separated origins, use "*" for development only)
ALLOWED_ORIGINS=*
